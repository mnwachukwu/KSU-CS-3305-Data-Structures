##
    A linked list of whole numbers, holding no tail pointer.

    The Java ended its list with null. There is none here, so the link is an optional and every
    walk has to prove there is a node before reading one — which is the 'temp != null' the Java
    wrote at the top of each loop, now checked by the compiler rather than by hand.
##
model LinkedList

    # @summary: The first node, absent while the list is empty.
    Node? head;

    # @summary: Adds a node to the end of the list.
    public function AddLastNode(integer data)
        if not this.head.HasValue()
            this.head = new Node(data);
            yield;
        end if

        Node temp = this.head.Value();

        loop while temp.next.HasValue()
            temp = temp.next.Value();
        end loop

        temp.next = new Node(data);
    end function

    # @summary: Adds a node to the front of the list.
    public function AddFirstNode(integer data)
        Node fresh = new Node(data);

        fresh.next = this.head;
        this.head = fresh;
    end function

    # @summary: Adds a node at a given position.
    # @index: where to put it, counting from 0.
    public function AddAtIndex(integer index, integer data)
        if index < 0
            throw new IndexOutOfRangeException("there is no index " + index);
        end if

        if index == 0
            this.AddFirstNode(data);
            yield;
        end if

        Node? current = this.head;
        integer count = 0;

        loop while current.HasValue() and count < index - 1
            current = current.Value().next;
            count = count + 1;
        end loop

        if not current.HasValue()
            throw new IndexOutOfRangeException("the list is shorter than " + index);
        end if

        Node holder = current.Value();
        Node fresh = new Node(data);

        fresh.next = holder.next;
        holder.next = fresh;
    end function

    # @summary: Removes the first node.
    public function RemoveFirstNode()
        if not this.head.HasValue()
            throw new Exception("the list is empty");
        end if

        this.head = this.head.Value().next;
    end function

    # @summary: Removes the last node.
    public function RemoveLastNode()
        if not this.head.HasValue()
            throw new Exception("the list is empty");
        end if

        Node first = this.head.Value();

        if not first.next.HasValue()
            this.head = LinkedList.NoNode();
            yield;
        end if

        Node current = first;

        loop while current.next.Value().next.HasValue()
            current = current.next.Value();
        end loop

        current.next = LinkedList.NoNode();
    end function

    # @summary: Removes the node at a given position.
    # @index: which one to remove, counting from 0.
    public function RemoveAtIndex(integer index)
        if index < 0
            throw new IndexOutOfRangeException("there is no index " + index);
        end if

        if not this.head.HasValue()
            throw new Exception("the list is empty");
        end if

        if index == 0
            this.RemoveFirstNode();
            yield;
        end if

        Node current = this.head.Value();
        integer count = 0;

        loop while current.next.HasValue() and count < index - 1
            current = current.next.Value();
            count = count + 1;
        end loop

        if not current.next.HasValue()
            throw new IndexOutOfRangeException("the list is shorter than " + index);
        end if

        current.next = current.next.Value().next;
    end function

    # @summary: How many nodes the list holds.
    public integer function CountNodes()
        integer listSize = 0;
        Node? current = this.head;

        loop while current.HasValue()
            listSize = listSize + 1;
            current = current.Value().next;
        end loop

        yield listSize;
    end function

    ##
        @summary: Writes the list back to front.

        @remarks: Recursive, as the assignment asked. Each call reaches the end before writing
        anything, so the writing happens as the calls unwind.
    ##
    public function PrintInReverse()
        LinkedList.PrintFrom(this.head);
    end function

    # @summary: Writes the list front to back.
    public function PrintList()
        Node? temp = this.head;

        loop while temp.HasValue()
            Console.Write(temp.Value().data + "   ");
            temp = temp.Value().next;
        end loop
    end function

    # @summary: Writes one node and everything after it, back to front.
    shared function PrintFrom(Node? link)
        if not link.HasValue()
            yield;
        end if

        LinkedList.PrintFrom(link.Value().next);
        Console.Write(link.Value().data + "   ");
    end function

    ##
        @summary: An absent node, for emptying a link.

        @remarks: There is no way to write an empty optional directly, so one is made by
        declaring it and handing it back untouched. This is what the Java said as 'null'.
    ##
    shared Node? function NoNode()
        Node? none;
        yield none;
    end function

    # @summary: One value in the list, and the link to whatever follows it.
    model Node
        public integer data;
        public Node? next;

        public function Node(integer item)
            this.data = item;
        end function
    end model

end model
