##
    Test program for LinkedList.

    The Java drove this from a menu. This runs a fixed sequence instead, so the output is the
    same every time and can be read against the list it describes.
##
shared model Program

    function Main()
        LinkedList list = new LinkedList();

        Console.WriteLine("Adding 10, 20, 30 to the end:");
        list.AddLastNode(10);
        list.AddLastNode(20);
        list.AddLastNode(30);
        Program.Show(list);

        Console.WriteLine("Adding 5 to the front:");
        list.AddFirstNode(5);
        Program.Show(list);

        Console.WriteLine("Adding 15 at index 2:");
        list.AddAtIndex(2, 15);
        Program.Show(list);

        Console.WriteLine("Counting: " + list.CountNodes() + " nodes");
        Console.WriteLine();

        Console.Write("In reverse: ");
        list.PrintInReverse();
        Console.WriteLine();
        Console.WriteLine();

        Console.WriteLine("Removing the first node:");
        list.RemoveFirstNode();
        Program.Show(list);

        Console.WriteLine("Removing the last node:");
        list.RemoveLastNode();
        Program.Show(list);

        Console.WriteLine("Removing the node at index 1:");
        list.RemoveAtIndex(1);
        Program.Show(list);

        Console.WriteLine("Asking for index 9, which is not there:");

        try
            list.RemoveAtIndex(9);
        catch IndexOutOfRangeException e
            Console.WriteLine("  refused: " + e.Message());
        end try
    end function

    # @summary: Writes the list and how long it is.
    function Show(LinkedList list)
        Console.Write("  ");
        list.PrintList();
        Console.WriteLine("(" + list.CountNodes() + " nodes)");
        Console.WriteLine();
    end function

end model
