# @summary: The vowel counting program.
shared model Program

    function Main()
        integer input = 0;
        string inputString = "";

        loop while input != 3
            Program.PrintMenu();

            # An empty answer is the input running out, which ends the program the way 3 does.
            input = Program.ReadInteger().Or(3);

            switch input
                case 1:
                    Console.Write("Enter a string: ");
                    inputString = Console.Read().Or("");

                case 2:
                    if inputString.Count > 0
                        Console.WriteLine("You entered string:\t" + inputString);
                        Console.WriteLine("Number of vowels:\t"
                            + Program.CountVowels(inputString));
                    else
                        Console.WriteLine("Input a string, first.");
                    end if

                default:
                    if input != 3
                        Console.WriteLine("Invalid option.");
                    end if
            end switch
        end loop

        Console.WriteLine("Program execution stopped.");
    end function

    # @summary: Writes the main menu.
    function PrintMenu()
        Console.WriteLine();
        Console.WriteLine("---------MAIN MENU---------");
        Console.WriteLine("1. Read input string");
        Console.WriteLine("2. Compute number of vowels");
        Console.WriteLine("3. Exit program");
        Console.WriteLine();
        Console.Write("Enter option number: ");
    end function

    ##
        @summary: How many vowels are in the text, counted by taking one letter at a time.

        @remarks: Recursive, as the assignment asked: the first letter is judged, and the rest
        of the text is handed to another call. An empty text has no vowels, which is what ends
        it.

        @text: the text to look through.
        @yields: the number of vowels in it.
    ##
    integer function CountVowels(string text)
        if text.Count == 0
            yield 0;
        end if

        character first = text.ToCharacters()[0];
        string rest = text.Subset(1);

        if Program.IsVowel(first)
            yield 1 + Program.CountVowels(rest);
        end if

        yield Program.CountVowels(rest);
    end function

    # @summary: Whether a character is a vowel, in either case.
    boolean function IsVowel(character c)
        yield c == 'A' or c == 'E' or c == 'I' or c == 'O' or c == 'U'
           or c == 'a' or c == 'e' or c == 'i' or c == 'o' or c == 'u';
    end function

    # @summary: A whole number typed in, absent once the input has run out.
    integer? function ReadInteger()
        integer? ranOut;
        string? typed = Console.Read();

        if not typed.HasValue()
            yield ranOut;
        end if

        yield typed.Value().ToInteger().Or(0);
    end function

end model
