##
    The average grades program.

    Where the Java held 'int[] classGrades = null' until a size was read, this holds an optional
    set. The difference is that the compiler will not let the grades be read until the program
    has proved they are there — the check the Java wrote by hand as 'classGrades != null'.
##
shared model Program

    function Main()
        integer input = 0;
        integer classSize = 0;
        integer[]? classGrades;

        loop while input != 4
            Program.PrintMenu();

            # An empty answer is the input running out, which ends the program the way 4 does.
            input = Program.ReadInteger().Or(4);

            switch input
                case 1:
                    Console.Write("Enter the class size: ");
                    classSize = Program.ReadInteger().Or(0);

                    integer[] sized = {};

                    loop for _ = 0 until classSize
                        sized.Insert(0);
                    end loop

                    classGrades = sized;

                case 2:
                    if classGrades.HasValue()
                        integer[] grades = classGrades.Value();

                        loop for i = 0 until classSize
                            Console.Write("Enter the grade for student "
                                + (i + 1) + " of " + classSize + ": ");

                            grades[i] = Program.ReadInteger().Or(0);
                        end loop
                    else
                        Console.WriteLine("Enter a class size, first.");
                    end if

                case 3:
                    if classGrades.HasValue()
                        integer[] grades = classGrades.Value();

                        Console.WriteLine("You entered class size:\t\t" + classSize);
                        Console.WriteLine("You entered grades:\t\t"
                            + Program.ClassGradesString(grades));
                        Console.WriteLine("Class average:\t\t\t"
                            + Program.FindAverage(grades, 0, 0).Format("F2"));
                    else
                        Console.WriteLine("Enter a class size, first.");
                    end if

                default:
                    if input != 4
                        Console.WriteLine("Invalid option.");
                    end if
            end switch
        end loop

        Console.WriteLine("Program execution stopped.");
    end function

    # @summary: Writes the main menu.
    function PrintMenu()
        Console.WriteLine();
        Console.WriteLine("---------MAIN MENU---------");
        Console.WriteLine("1. Read class size");
        Console.WriteLine("2. Read class grades");
        Console.WriteLine("3. Compute class average");
        Console.WriteLine("4. Exit program");
        Console.WriteLine();
        Console.Write("Enter option number: ");
    end function

    ##
        @summary: The average of the numbers, worked out by walking the set.

        @remarks: Recursive, as the assignment asked. Each call takes one more number into the
        running sum and hands the rest on; the last one divides.

        @nums: the grades.
        @index: how far along the set this call is.
        @sum: the total of everything before this index.
        @yields: the mean, or 0 for an empty set.
    ##
    real function FindAverage(integer[] nums, integer index, integer sum)
        if nums.Count == 0
            yield 0;
        end if

        if index >= nums.Count
            real total = sum;
            yield total / nums.Count;
        end if

        yield Program.FindAverage(nums, index + 1, sum + nums[index]);
    end function

    # @summary: The grades in a line, separated by spaces.
    string function ClassGradesString(integer[] classGrades)
        string written = "";

        loop each grade in classGrades
            written = written + grade + " ";
        end loop

        yield written;
    end function

    ##
        @summary: A whole number typed in, absent once the input has run out.

        @remarks: Absence here is the end of the input, not a mistake, and the menu loop reads it
        as a reason to stop. The Java raised at this point instead, because a Scanner has nothing
        else to say; an optional lets the program answer for itself.

        A line that is not a number counts as 0, which is what the Scanner would have made of it.

        @yields: the number, or nothing once there is no more input.
    ##
    integer? function ReadInteger()
        integer? ranOut;
        string? typed = Console.Read();

        if not typed.HasValue()
            yield ranOut;
        end if

        integer? number = typed.Value().ToInteger();

        yield number.Or(0);
    end function

end model
