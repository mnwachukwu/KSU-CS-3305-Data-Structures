##
    Test program for Rectangle.

    Where the Java read with a Scanner and trusted Double.parseDouble, Compass hands back an
    optional from both the read and the conversion: input can run out, and text may not spell a
    number. Neither is a fault, so neither raises — the program says what it will use instead.
##
shared model Program

    function Main()
        Rectangle myRectangle = new Rectangle();

        Console.Write("Enter a width for your rectangle: ");
        real width = Program.ReadReal();

        Console.Write("Enter a height for your rectangle: ");
        real height = Program.ReadReal();

        Rectangle yourRectangle = new Rectangle(width, height);

        Console.WriteLine("My Rectangle");
        Program.Describe(myRectangle, "myRectangle");

        Console.WriteLine();

        Console.WriteLine("Your Rectangle");
        Program.Describe(yourRectangle, "yourRectangle");
    end function

    # @summary: Writes every measurement of one rectangle.
    function Describe(Rectangle which, string name)
        Console.WriteLine("Width: " + which.GetWidth());
        Console.WriteLine("Height: " + which.GetHeight());
        Console.WriteLine("Area: " + which.GetArea());
        Console.WriteLine("Perimeter: " + which.GetPerimeter());
        Console.WriteLine(which.PrintRectangle(name));
    end function

    ##
        @summary: A number typed in, or 1 where nothing usable was.

        @remarks: Two things can be absent here and they are different: the input running out,
        and the line not spelling a number. Both end in the same fallback, so both are asked
        about in one place rather than at every call.

        @yields: what was typed, or 1.
    ##
    real function ReadReal()
        string? typed = Console.Read();

        if typed.HasValue()
            real? number = typed.Value().ToReal();

            if number.HasValue()
                yield number.Value();
            end if
        end if

        yield 1;
    end function

end model
