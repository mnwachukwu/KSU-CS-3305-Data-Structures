# @summary: A week of temperatures, one for each day.
model DailyTemps

    # @summary: Index 0 is Monday, 1 is Tuesday, and so on.
    integer[] temps;

    ##
        @summary: The names of the days, in the order the readings come in.

        @remarks: A field rather than a constant. 'constant' covers the types whose
        immutability is already complete, which sets are not yet among.
    ##
    public shared string[] Days = {"Monday", "Tuesday", "Wednesday",
                                   "Thursday", "Friday", "Saturday", "Sunday"};

    # @summary: Takes all seven daily temperatures.
    # @readings: one reading per day, Monday first.
    public function DailyTemps(integer[] readings)
        this.temps = readings;
    end function

    # @summary: Resets the temperature for one day.
    # @dayIndex: which day, 0 for Monday through 6 for Sunday.
    # @temperature: the new reading.
    public function SetTemp(integer dayIndex, integer temperature)
        if dayIndex >= 0 and dayIndex <= 6
            this.temps[dayIndex] = temperature;
        end if
    end function

    # @summary: How many days were below freezing.
    # @yields: the count of readings under 32.
    public integer function Freezing()
        integer count = 0;

        loop each t in this.temps
            if t < 32
                count = count + 1;
            end if
        end loop

        yield count;
    end function

    # @summary: The name of the warmest day, the earliest one where two tie.
    public string function Warmest()
        integer warmest = 0;

        loop for i = 1 until this.temps.Count
            if this.temps[i] > this.temps[warmest]
                warmest = i;
            end if
        end loop

        yield DailyTemps.Days[warmest];
    end function

    ##
        @summary: Writes every day and its reading, the days in a column.

        @remarks: The Java wrote this with printf and '%-10s'. Compass has no field width, so
        the padding is done here — which is all printf was doing.
    ##
    public function PrintTemps()
        loop for i = 0 until this.temps.Count
            Console.WriteLine(DailyTemps.Pad(DailyTemps.Days[i], 10) + this.temps[i]);
        end loop
    end function

    # @summary: Text with spaces added until it is at least 'width' long.
    shared string function Pad(string text, integer width)
        string padded = text;

        loop while padded.Count < width
            padded = padded.Insert(" ");
        end loop

        yield padded;
    end function

end model
