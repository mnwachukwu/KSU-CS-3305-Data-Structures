# @summary: Test program for DailyTemps.
shared model Program

    function Main()
        integer[] temps = {};

        Console.WriteLine("Enter daily temperatures for the week:");

        loop for i = 0 until 7
            Console.Write(DailyTemps.Days[i] + ": ");
            temps.Insert(Program.ReadInteger());
        end loop

        DailyTemps week = new DailyTemps(temps);

        Console.WriteLine();
        Console.WriteLine("Testing method PrintTemps:");
        week.PrintTemps();

        Console.WriteLine();
        Console.WriteLine("Testing method Freezing:");
        Console.WriteLine("Number of freezing days is " + week.Freezing() + " days");

        Console.WriteLine();
        Console.WriteLine("Testing method Warmest:");
        Console.WriteLine("The warmest day of the week is " + week.Warmest());

        Console.WriteLine();
        Console.WriteLine("Testing method SetTemp:");
        Console.Write("Enter day index to change (0=Monday ... 6=Sunday): ");
        integer dayIndex = Program.ReadInteger();

        Console.Write("Enter new temperature: ");
        integer newTemp = Program.ReadInteger();

        week.SetTemp(dayIndex, newTemp);

        Console.WriteLine();
        Console.WriteLine("Updated temperatures:");
        week.PrintTemps();
    end function

    # @summary: A whole number typed in, or 0 where nothing usable was.
    # @yields: what was typed, or 0.
    integer function ReadInteger()
        string? typed = Console.Read();

        if typed.HasValue()
            integer? number = typed.Value().ToInteger();

            if number.HasValue()
                yield number.Value();
            end if
        end if

        yield 0;
    end function

end model
