##
    Four hash functions over a fixed set of 50 unique keys.

    The table is 50 rows of two columns: column 0 holds the key placed at that index, and
    column 1 holds how many collision probes it took to place it. A probe count of 0 means the
    key landed on its home index with nothing in the way.

    The Java kept the long constants as 'long' because an int could not hold them. An integer
    here is 64 bits, so there is one whole-number type and the distinction goes away.
##
shared model Program

    # ---- Constants -----------------------------------------------------------------------

    # @summary: The fixed set of 50 unique keys the assignment specifies.
    integer[] Keys = {1234, 8234, 7867, 1009, 5438,
        4312, 3420, 9487, 5418, 5299, 5078, 8239, 1208, 5098, 5195,
        5329, 4543, 3344, 7698, 5412, 5567, 5672, 7934, 1254, 6091,
        8732, 3095, 1975, 3843, 5589, 5439, 8907, 4097, 3096, 4310,
        5298, 9156, 3895, 6673, 7871, 5787, 9289, 4553, 7822, 8755,
        3398, 6774, 8289, 7665, 5523};

    # @summary: How many slots the table has, which is how many keys there are.
    integer TableSize = 50;

    ##
        @summary: How many probes past the home slot a key may take before it is given up on.

        @remarks: Without a cap, a probing sequence that cycles through occupied slots without
        covering the table would never end. HF3 can do this when its step shares a factor
        with the table size.
    ##
    integer MaxProbes = 50;

    ##
        @summary: Knuth's multiplicative constant, floor(2^32 / phi).

        @remarks: phi inverse is the most irrational number there is, so the fractional parts
        of multiplying by it spread across the range as evenly as any sequence can. Keys close
        in value land far apart.
    ##
    integer KnuthConstant = 2654435769;

    ##
        @summary: A second multiplicative constant, for HF4's step.

        @remarks: Deliberately different from the one above. If the step used the same
        constant, two keys colliding at the primary hash would follow the same probe sequence
        and go on colliding.
    ##
    integer StepConstant = 2654435761;

    ##
        @summary: The 20 numbers in 1 to 49 that share no factor with 50.

        @remarks: A double-hashing step visits every slot before repeating only where the step
        and the table size are coprime. 50 is 2 times 5 squared, so a step qualifies when it is
        odd and not a multiple of 5 — which is 20 of them.
    ##
    integer[] ValidSteps = {1, 3, 7, 9, 11, 13, 17, 19, 21, 23,
                                   27, 29, 31, 33, 37, 39, 41, 43, 47, 49};

    # @summary: The lower 32 bits, for pulling a fractional part out of a product.
    integer LowerBits = 4294967295;

    # ---- The program ---------------------------------------------------------------------

    function Main()
        integer choice = 0;

        loop
            Program.DisplayMenu();

            # An empty answer is the input running out, which ends the program the way 5 does.
            choice = Program.ReadInteger().Or(5);

            switch choice
                case 1:
                    integer[][] one = Program.NewTable();
                    Program.HF1(one);
                    Program.DisplayTable(one, "HF1 (Division with Linear Probing)");

                case 2:
                    integer[][] two = Program.NewTable();
                    Program.HF2(two);
                    Program.DisplayTable(two, "HF2 (Division with Quadratic Probing)");

                case 3:
                    integer[][] three = Program.NewTable();
                    Program.HF3(three);
                    Program.DisplayTable(three, "HF3 (Division with Double Hashing)");

                case 4:
                    integer[][] four = Program.NewTable();
                    Program.HF4(four);
                    Program.DisplayTable(four, "HF4 (Student Designed HF)");

                case 5:
                    Console.WriteLine("Exiting program.");

                default:
                    Console.WriteLine("Invalid option. Please enter 1 through 5.");
            end switch
        until choice == 5
    end function

    # @summary: Writes the main menu.
    function DisplayMenu()
        Console.WriteLine();
        Console.WriteLine("-----MAIN MENU-------------------------------------");
        Console.WriteLine("1. Run HF1 (Division method with Linear Probing)");
        Console.WriteLine("2. Run HF2 (Division method with Quadratic Probing)");
        Console.WriteLine("3. Run HF3 (Division method with Double Hashing)");
        Console.WriteLine("4. Run HF4 (Student Designed HF)");
        Console.WriteLine("5. Exit program");
        Console.Write("Enter option number: ");
    end function

    # @summary: An empty table: 50 rows of a key and a probe count, both zero.
    integer[][] function NewTable()
        integer[][] table = {};

        loop for _ = 0 until Program.TableSize
            table.Insert({0, 0});
        end loop

        yield table;
    end function

    ##
        @summary: Writes the table, then the total probe count.

        @remarks: A key of 0 means the slot was never filled — none of the 50 keys is 0, so it
        is a safe way to say "empty".

        @table: the filled table.
        @hfName: which hash function built it.
    ##
    function DisplayTable(integer[][] table, string hfName)
        Console.WriteLine();
        Console.WriteLine("Hash table resulted from " + hfName + ":");
        Console.WriteLine();
        Console.WriteLine(Program.Pad("Index", 8) + "  " + Program.Pad("Key", 10)
            + "  " + Program.Pad("Probes", 8));
        Console.WriteLine("------------------------");

        loop for i = 0 until Program.TableSize
            string key = "---";
            string probes = "---";

            if table[i][0] != 0
                key = "" + table[i][0];
                probes = "" + table[i][1];
            end if

            Console.WriteLine("  " + Program.Pad("" + i, 6) + "  " + Program.Pad(key, 10)
                + "  " + Program.Pad(probes, 8));
        end loop

        Console.WriteLine("------------------------");
        Console.WriteLine();
        Console.WriteLine("Sum of probe values = " + Program.SumProbes(table) + " probes.");
        Console.WriteLine();
    end function

    ##
        @summary: The probe counts of every slot holding a key, added up.

        @remarks: One number for how well a hash function did. Lower is better.
    ##
    integer function SumProbes(integer[][] table)
        integer sum = 0;

        loop for i = 0 until Program.TableSize
            if table[i][0] != 0
                sum = sum + table[i][1];
            end if
        end loop

        yield sum;
    end function

    # ---- The hash functions --------------------------------------------------------------

    ##
        @summary: HF1, the division method with linear probing.

        @remarks: The home index is the key modulo the table size. On a collision the search
        moves along one slot at a time, wrapping at the end. A step of 1 shares no factor with
        anything, so this always finds a free slot while one exists.
    ##
    function HF1(integer[][] table)
        loop each key in Program.Keys
            integer index = key % Program.TableSize;
            integer probes = 0;

            loop while table[index][0] != 0
                probes = probes + 1;
                index = (index + 1) % Program.TableSize;
            end loop

            table[index][0] = key;
            table[index][1] = probes;
        end loop
    end function

    ##
        @summary: HF2, the division method with quadratic probing.

        @remarks: Each attempt adds j squared to the *home* index rather than to the slot last
        looked at. Applying j squared to the previous position instead is the usual way to get
        this wrong.
    ##
    function HF2(integer[][] table)
        loop each key in Program.Keys
            integer homeIndex = key % Program.TableSize;
            integer index = homeIndex;
            integer probes = 0;
            integer j = 1;

            loop while table[index][0] != 0
                probes = probes + 1;
                index = (homeIndex + j * j) % Program.TableSize;
                j = j + 1;
            end loop

            table[index][0] = key;
            table[index][1] = probes;
        end loop
    end function

    ##
        @summary: HF3, the division method with double hashing.

        @remarks: The step comes from a second hash of the key, which gives 6 to 30. Where that
        step shares a factor with 50 the sequence cycles through a subset of the slots, so a
        key can run out of attempts and be reported rather than placed.
    ##
    function HF3(integer[][] table)
        loop each key in Program.Keys
            integer homeIndex = key % Program.TableSize;
            integer index = homeIndex;
            integer probes = 0;
            boolean placed = true;

            if table[index][0] != 0
                # The home slot being taken is itself the first collision.
                probes = 1;

                integer h2 = 30 - (key % 25);
                placed = false;

                loop for j = 1 to Program.MaxProbes
                    index = (homeIndex + j * h2) % Program.TableSize;

                    if table[index][0] == 0
                        placed = true;
                        break;
                    end if

                    probes = probes + 1;
                end loop
            end if

            if placed
                table[index][0] = key;
                table[index][1] = probes;
            else
                Console.WriteLine("Unable to hash key " + key + " to the table.");
            end if
        end loop
    end function

    ##
        @summary: HF4, Fibonacci hashing with double hashing to resolve collisions.

        @remarks: The key is multiplied by Knuth's constant; the lower 32 bits of the product
        are the fractional part of key times phi inverse, scaled. Scaling those to the table
        size gives the home index.

        The step is the same computation with a different constant, used to choose one of the
        20 steps coprime with 50 — which guarantees the probe sequence covers every slot.
    ##
    function HF4(integer[][] table)
        loop each key in Program.Keys
            integer primaryProduct = (key bitwise and Program.LowerBits) * Program.KnuthConstant;
            integer fracPart = primaryProduct bitwise and Program.LowerBits;
            integer index = (fracPart * Program.TableSize) shiftright 32;

            integer probes = 0;

            if table[index][0] != 0
                probes = 1;

                integer stepProduct = (key bitwise and Program.LowerBits) * Program.StepConstant;
                integer stepFrac = stepProduct bitwise and Program.LowerBits;
                integer stepIndex = (stepFrac * Program.ValidSteps.Count) shiftright 32;
                integer step = Program.ValidSteps[stepIndex];

                loop for _ = 1 to Program.MaxProbes
                    index = (index + step) % Program.TableSize;

                    if table[index][0] == 0
                        break;
                    end if

                    probes = probes + 1;
                end loop
            end if

            table[index][0] = key;
            table[index][1] = probes;
        end loop
    end function

    # ---- Two small helpers ---------------------------------------------------------------

    ##
        @summary: Text with spaces added until it is at least 'width' long.

        @remarks: The Java wrote its columns with printf and a field width. Compass has none,
        so the padding is done here — which is all the field width was doing.
    ##
    string function Pad(string text, integer width)
        string padded = text;

        loop while padded.Count < width
            padded = padded.Insert(" ");
        end loop

        yield padded;
    end function

    # @summary: A whole number typed in, absent once the input has run out.
    integer? function ReadInteger()
        integer? ranOut;
        string? typed = Console.Read();

        if not typed.HasValue()
            yield ranOut;
        end if

        yield typed.Value().ToInteger().Or(0);
    end function

end model
