##
    Graph reachability matrices.

    A directed graph is given as an adjacency matrix A1. From it the program computes
    R = A1 + A2 + ... + AN, where Ak is the k-th matrix power of A1, and derives ten metrics.

    A grid here is 'integer[][]' — a set whose elements are sets — and the powers are
    'integer[][][]', a set of grids. Neither needed a feature of its own: '[]' means "a set of",
    and it can be said twice or three times.
##
model Graph

    # @summary: How many nodes the graph has.
    public integer n;

    # @summary: The adjacency matrix, as it was entered.
    public integer[][] a1;

    # @summary: Takes the node count and the adjacency matrix.
    public function Graph(integer n, integer[][] a1)
        this.n = n;
        this.a1 = a1;
    end function

    # @summary: A grid of the given size, every cell zero.
    public shared integer[][] function Zeros(integer size)
        integer[][] built = {};

        loop for _ = 0 until size
            integer[] row = {};

            loop for _ = 0 until size
                row.Insert(0);
            end loop

            built.Insert(row);
        end loop

        yield built;
    end function

    # @summary: Two square matrices multiplied, the standard triple loop.
    public integer[][] function Multiply(integer[][] m1, integer[][] m2)
        integer[][] result = Graph.Zeros(this.n);

        loop for i = 0 until this.n
            loop for j = 0 until this.n
                # The dot product of row i of m1 with column j of m2.
                loop for k = 0 until this.n
                    result[i][j] = result[i][j] + m1[i][k] * m2[k][j];
                end loop
            end loop
        end loop

        yield result;
    end function

    ##
        @summary: A^1 through A^N.

        @remarks: Element 0 is A^1, which is the adjacency matrix itself; each one after it is
        the one before multiplied by A1.
    ##
    public integer[][][] function ComputePowers()
        integer[][][] powers = {this.a1};

        loop for k = 1 until this.n
            powers.Insert(this.Multiply(powers[k - 1], this.a1));
        end loop

        yield powers;
    end function

    # @summary: R = A^1 + A^2 + ... + A^N, summed cell by cell.
    public integer[][] function ComputeReachability(integer[][][] powers)
        integer[][] r = Graph.Zeros(this.n);

        loop for k = 0 until this.n
            loop for i = 0 until this.n
                loop for j = 0 until this.n
                    r[i][j] = r[i][j] + powers[k][i][j];
                end loop
            end loop
        end loop

        yield r;
    end function

    # ---- The ten required outputs --------------------------------------------------------

    # @summary: Writes a grid, each value followed by two spaces.
    public function PrintMatrix(string title, integer[][] matrix)
        Console.WriteLine(title);

        loop for i = 0 until this.n
            loop for j = 0 until this.n
                Console.Write(matrix[i][j] + "  ");
            end loop

            Console.WriteLine();
        end loop
    end function

    ##
        @summary: Writes the in-degree of every node.

        @remarks: The in-degree of node j is the sum of column j: how many edges point into it.
    ##
    public function PrintInDegrees()
        Console.WriteLine("In-degrees:");

        loop for j = 0 until this.n
            integer sum = 0;

            loop for i = 0 until this.n
                sum = sum + this.a1[i][j];
            end loop

            Console.WriteLine("Node " + (j + 1) + " in-degree is " + sum);
        end loop
    end function

    # @summary: Writes the out-degree of every node, which is the sum of its row.
    public function PrintOutDegrees()
        Console.WriteLine("Out-degrees:");

        loop for i = 0 until this.n
            integer sum = 0;

            loop for j = 0 until this.n
                sum = sum + this.a1[i][j];
            end loop

            Console.WriteLine("Node " + (i + 1) + " out-degree is " + sum);
        end loop
    end function

    ##
        @summary: Writes how many self-loops the graph has.

        @remarks: A self-loop at node i is a non-zero A1[i][i], and the values are 0 or 1, so
        the diagonal sums to the count.
    ##
    public function PrintSelfLoops()
        Console.WriteLine("Total number of self-loops: " + this.Trace(this.a1));
    end function

    ##
        @summary: Writes how many cycles of exactly N edges there are.

        @remarks: The trace of A^N: A^N[i][i] counts the closed walks of length N that start
        and end at node i.
    ##
    public function PrintCycles(integer[][] an)
        Console.WriteLine("Total number of cycles of length " + this.n
            + " edges: " + this.Trace(an));
    end function

    # @summary: Writes how many paths of exactly one edge there are, which is every entry of A1.
    public function PrintPathsOfLength1()
        Console.WriteLine("Total number of paths of length 1 edge: " + this.Total(this.a1));
    end function

    # @summary: Writes how many paths of exactly N edges there are, which is every entry of A^N.
    public function PrintPathsOfLengthN(integer[][] an)
        Console.WriteLine("Total number of paths of length " + this.n
            + " edges: " + this.Total(an));
    end function

    # @summary: Writes how many paths of one through N edges there are, which is every entry of R.
    public function PrintPathsOfLength1ToN(integer[][] r)
        Console.WriteLine("Total number of paths of length 1 to " + this.n
            + " edges: " + this.Total(r));
    end function

    # @summary: Writes how many cycles of one through N edges there are, the trace of R.
    public function PrintCyclesOfLength1ToN(integer[][] r)
        Console.WriteLine("Total number of cycles of length 1 to " + this.n
            + " edges: " + this.Trace(r));
    end function

    # ---- Two sums the outputs above share ------------------------------------------------

    # @summary: The sum of a grid's diagonal.
    integer function Trace(integer[][] matrix)
        integer sum = 0;

        loop for i = 0 until this.n
            sum = sum + matrix[i][i];
        end loop

        yield sum;
    end function

    # @summary: The sum of every cell in a grid.
    integer function Total(integer[][] matrix)
        integer sum = 0;

        loop for i = 0 until this.n
            loop for j = 0 until this.n
                sum = sum + matrix[i][j];
            end loop
        end loop

        yield sum;
    end function

end model

##
    The menu.

    Where the Java kept a 'dataEntered' flag beside the matrix, this holds an optional graph.
    The flag and the data are the same fact, and an optional says it once.
##
shared model Program

    function Main()
        Graph? graph;
        integer option = 0;

        loop
            Console.WriteLine();
            Program.DisplayMenu();

            # An empty answer is the input running out, which ends the program the way 3 does.
            option = Program.ReadInteger().Or(3);
            Console.WriteLine();

            switch option
                case 1:
                    graph = Program.EnterGraphData();

                case 2:
                    if graph.HasValue()
                        Program.PrintOutputs(graph.Value());
                    else
                        Console.WriteLine("Error: Please enter graph data first (Option 1).");
                    end if

                case 3:
                    Console.WriteLine("Exiting program. Goodbye.");

                default:
                    Console.WriteLine("Invalid option. Please enter 1, 2, or 3.");
            end switch
        until option == 3
    end function

    # @summary: Writes the main menu.
    function DisplayMenu()
        Console.WriteLine("------MAIN MENU------");
        Console.WriteLine("1. Enter graph data");
        Console.WriteLine("2. Print outputs");
        Console.WriteLine("3. Exit program");
        Console.Write("Enter option number: ");
    end function

    # @summary: Reads the node count and the adjacency matrix, one cell at a time.
    Graph function EnterGraphData()
        Console.Write("Enter number of nodes (1 to 5): ");
        integer n = Program.ReadInteger().Or(1);

        integer[][] a1 = {};

        loop for i = 0 until n
            integer[] row = {};

            loop for j = 0 until n
                Console.Write("Enter A1[" + i + "," + j + "]: ");
                row.Insert(Program.ReadInteger().Or(0));
            end loop

            a1.Insert(row);
        end loop

        Console.WriteLine();
        Console.WriteLine("Graph data entered successfully.");

        yield new Graph(n, a1);
    end function

    # @summary: Works out every result and writes the ten outputs in order.
    function PrintOutputs(Graph graph)
        integer[][][] powers = graph.ComputePowers();
        integer[][] r = graph.ComputeReachability(powers);
        integer[][] an = powers[graph.n - 1];

        graph.PrintMatrix("Input Matrix:", graph.a1);
        Console.WriteLine();
        graph.PrintMatrix("Reachability Matrix:", r);
        Console.WriteLine();
        graph.PrintInDegrees();
        Console.WriteLine();
        graph.PrintOutDegrees();
        Console.WriteLine();
        graph.PrintSelfLoops();
        Console.WriteLine();
        graph.PrintCycles(an);
        Console.WriteLine();
        graph.PrintPathsOfLength1();
        Console.WriteLine();
        graph.PrintPathsOfLengthN(an);
        Console.WriteLine();
        graph.PrintPathsOfLength1ToN(r);
        Console.WriteLine();
        graph.PrintCyclesOfLength1ToN(r);
        Console.WriteLine();
        Console.WriteLine("--------------------------------------------------");
    end function

    # @summary: A whole number typed in, absent once the input has run out.
    integer? function ReadInteger()
        integer? ranOut;
        string? typed = Console.Read();

        if not typed.HasValue()
            yield ranOut;
        end if

        yield typed.Value().ToInteger().Or(0);
    end function

end model
